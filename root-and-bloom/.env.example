# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# BACKEND_PORT: Private API process port. Keep this bound to localhost.
BACKEND_PORT=3001

# PUBLIC_PORT: Customer-facing storefront port.
PUBLIC_PORT=3000

# BACKEND_URL: Private backend URL used by the production storefront proxy.
BACKEND_URL="http://127.0.0.1:3001"

# PUBLIC_ORIGIN: Optional browser origin allow-list for direct backend requests.
PUBLIC_ORIGIN="http://127.0.0.1:3000"

# EDITOR_INVITE_CODE: Required to register a new editor account. Keep this secret.
EDITOR_INVITE_CODE="SET_A_PRIVATE_EDITOR_INVITE_CODE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_OPENWEATHER_API_KEY: Optional API key for live OpenWeather microclimate data
VITE_OPENWEATHER_API_KEY=""
